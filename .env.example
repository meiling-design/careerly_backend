# ── LLM Provider (DashScope / OpenAI 兼容) ──────────────────────────
# 必填: 填入你的 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-plus

# 留空则自动继承 DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL
LLM_API_KEY=
LLM_BASE_URL=

# ── 切换为其他 LLM 提供商 ──────────────────────────────────────────
# OpenAI:
#   LLM_API_KEY=sk-xxxxx
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o
#
# DeepSeek:
#   LLM_API_KEY=sk-xxxxx
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#
# Anthropic (通过 OpenAI 兼容代理):
#   LLM_API_KEY=sk-ant-xxxxx
#   LLM_BASE_URL=https://api.anthropic.com/v1

# ── Embedding (语义向量) ───────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ── Web Search (Tavily — 仅旧版单智能体使用) ───────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── LangSmith (追踪调试 — 可选) ────────────────────────────────────
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=work_agent

# ── Application ────────────────────────────────────────────────────
DEBUG=false

# ── Distributed Cache (Redis — 可选) ───────────────────────────────
# REDIS_URL=redis://redis:6379/0

# ── Playwright 并发控制 ────────────────────────────────────────────
# MAX_PLAYWRIGHT_INSTANCES=2

# ── Demo Guard (游客体验限制) ──────────────────────────────────────
DEMO_MODE=true
DEMO_MAX_MATCHES=1

# ── Client Authentication ──────────────────────────────────────────
# 逗号分隔的允许 X-Client-Key 值。留空 = 不校验（仅开发）。
ALLOWED_CLIENT_KEYS=demo-web-client

# ── LLM Cost Protection (输入长度限制) ─────────────────────────────
MAX_RESUME_CHARS=80000
MAX_JD_CHARS=20000
MAX_JOB_URLS=10

# ── API Security (生产环境推荐) ────────────────────────────────────
# API_KEY=your-secret-api-key
# RATE_LIMIT=60
