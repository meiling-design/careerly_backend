# ── LLM Provider (DashScope / OpenAI 兼容) ──────────────────────────
# 必填: 填入你的 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-plus

# 留空则自动继承 DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL
LLM_API_KEY=
LLM_BASE_URL=

# ── 切换为其他 LLM 提供商 ──────────────────────────────────────────
# OpenAI:
#   LLM_API_KEY=sk-xxxxx
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o
#
# DeepSeek:
#   LLM_API_KEY=sk-xxxxx
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#
# Anthropic (通过 OpenAI 兼容代理):
#   LLM_API_KEY=sk-ant-xxxxx
#   LLM_BASE_URL=https://api.anthropic.com/v1

# ── Embedding (语义向量) ───────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ── Web Search (Tavily — 仅旧版单智能体使用) ───────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── LangSmith (追踪调试 — 可选) ────────────────────────────────────
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=work_agent

# ── Application ────────────────────────────────────────────────────
DEBUG=false

# ── 数据根（DATA_DIR）──────────────────────────────────────────────
# 后端的数据分**两棵树**（历史遗留，同名不同文件，不能合并）：
#   <root>/app/data/   auth.db · careerly.db · graph_state.db(引擎)
#                      outputs/ · uploads/ · resumes/
#   <root>/data/       graph_state.db(DemoGuard 试用计数) · uploads/ · resumes/
#
# 留空（默认）= 两棵树留在仓库目录内。**在阿里云 ECS 上这就是正常形态** ——
#   持久 VM 上仓库内落盘不会丢，把数据盘挂到 /opt/careerly 或做软链即可，
#   无需设置本项（见 docs/09_Release/DEPLOY_ECS.md §3）。
#
# 设为绝对路径 = 两棵树原样搬到 <DATA_DIR>/app 与 <DATA_DIR>/root，文件名、
#   子目录名一概不变。适用于「仓库放系统盘、数据放数据盘」的分离部署。
#   必须写**绝对路径**（相对路径按进程 cwd 解析，systemd 下即 WorkingDirectory）。
#
# ⚠️ 本项**不属于**下方「生产环境的四条硬性配置」，不设不会阻止启动。
# ⚠️ tessdata/（OCR 中文语言包，~2.5MB）**不跟随** DATA_DIR —— 它是随代码仓
#    发布的只读资源，跟到空的数据盘上会让中文 OCR 静默退化成默认语言包。
# DATA_DIR=/data/careerly

# ── Distributed Cache (Redis — 可选) ───────────────────────────────
# REDIS_URL=redis://redis:6379/0

# ── Playwright 并发控制 ────────────────────────────────────────────
# MAX_PLAYWRIGHT_INSTANCES=2

# ── Demo Guard (游客体验限制) ──────────────────────────────────────
DEMO_MODE=true
DEMO_MAX_MATCHES=1

# ── Client Authentication ──────────────────────────────────────────
# 逗号分隔的允许 X-Client-Key 值。留空 = 不校验（仅开发）。
ALLOWED_CLIENT_KEYS=demo-web-client

# ── LLM Cost Protection (输入长度限制) ─────────────────────────────
MAX_RESUME_CHARS=80000
MAX_JD_CHARS=20000
MAX_JOB_URLS=10

# ── API Security (生产环境推荐) ────────────────────────────────────
# API_KEY=your-secret-api-key
# RATE_LIMIT=60

# ── Auth / JWT ────────────────────────────────────────────────────
# ⚠️ ENV=production 时这个值**必须**换成真随机长字符串（≥32 字符）。
#    留空 / 保留示例值 / 太短 → 进程**拒绝启动**（发布基线 R0-2 ①）。
#    该密钥用于签发所有用户的 access / refresh token；用默认值等于
#    任何人都能伪造任意账号的凭据。
#    生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# P1-6 / D-B：7 → 90。Careerly 是低频产品，且与「安全持久化」配套 ——
# 只持久化不动有效期，用户超过一周没打开仍要重登（正式认证下 = 收短信）。
# access 仍仅 60 分钟，泄露窗口未变大；refresh 每次使用都会轮换。
REFRESH_TOKEN_EXPIRE_DAYS=90

# ── DEV / PROD 认证边界（决策 D-NEW 方案 A · P0-6）────────────────
# ENV        运行环境。production / prod 视为生产；默认 development。
# AUTH_MODE  认证模式。dev（默认，手机号直登、无凭证校验）或 formal。
#
# ⚠️ DEV 认证：只知道手机号即可登录。因此：
#     ENV=production + AUTH_MODE=dev  →  进程**拒绝启动**（fail-fast）
#   这是刻意的硬阻断：告警会被忽略，「先这样跑着，等上线再补」正是它要拦的事。
ENV=development
AUTH_MODE=dev

# ── 生产环境的四条硬性配置（发布基线 R0-2）─────────────────────────
# 下面四项**缺任何一项，ENV=production 下进程都拒绝启动**。
# 这不是配置建议，是启动前置条件 —— 每一项缺失都对应一个「能跑但等于
# 没有防护」的形态，而那种形态会在日志里安静地跑上几个月没有人发现。
#
#   ENV=production               声明这是生产
#   AUTH_MODE=formal             关闭手机号直登（须先清空无密码账号：
#                                scripts/purge_passwordless_accounts.py）
#   JWT_SECRET_KEY=<32+ 随机>    见上方说明
#   CORS_ALLOW_ORIGINS=<来源>    见下方说明
#
# 阿里云 ECS 上不要把这些写进服务器上的 .env 文件 —— 用 systemd 的
# EnvironmentFile=（权限 600，仅 root 可读）。见
# docs/09_Release/DEPLOY_ECS.md（发布基线 R0-3）。

# CORS 白名单（逗号分隔）。生产**必须**显式配置：留空会回退到
# allow_origins=["*"]，等于任何站点都能从用户浏览器调用本 API。
# 移动端 App 不走浏览器同源策略，不受本项约束 —— 这里限制的是 Web / 管理端。
# CORS_ALLOW_ORIGINS=https://app.example.com,https://example.com

# 可选：启用 API Key 鉴权（服务级，与用户 JWT 独立）
# API_KEY=your-service-api-key
# RATE_LIMIT=60
