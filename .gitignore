# Environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]

# Virtual Env
venv/
.venv/

# IDE
.vscode/
.idea/

# Runtime Data
app/data/uploads/*
app/data/outputs/*

# OCR 语言包（chi_sim，~2.5MB 二进制）—— 不进仓库，见 app/data/tessdata/README.md
app/data/tessdata/*.traineddata

# Keep folders
!app/data/uploads/.gitkeep
!app/data/outputs/.gitkeep

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Runtime SQLite databases (local state — never commit)
app/data/*.db
app/data/*.db-shm
app/data/*.db-wal
data/*.db

# WorkBuddy local memory / workspace data
.workbuddy/

# Pytest 用例自建的临时库目录（刻意不删除：沙箱 safe-delete 会拦截 unlink/rmtree）
tests/.tmp_p1/
tests/.tmp_engine/
.pytest_tmp/

# 本地联调产物 —— 接口响应转储 / 真机截图，只在本机有意义
/proj.json
/*.png
